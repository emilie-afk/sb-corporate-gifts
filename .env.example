# Copy to .env for local use. Never commit real values. In Netlify, set these in
# Site configuration → Environment variables (mark secrets as "Contains secret values").

# Managed PostgreSQL connection string (server-side only)
DATABASE_URL=
# Optional: DB_POOL_MAX=3, DATABASE_SSL=false (local only)

# Random string, at least 32 characters (signs the session cookie)
SESSION_SECRET=

# Google OAuth web client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Approved Google login(s), comma separated. Set privately in Netlify only — never in code or docs.
APPROVED_GOOGLE_EMAILS=

# Public base URL of this deploy context, e.g. the production site URL (used for the OAuth redirect)
APP_BASE_URL=

# Product Master read access: service-account JSON key (share the sheet with its client_email as Viewer)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional override; defaults to https://succulentsbox.com
# SHOPIFY_CATALOG_ORIGIN=
