# Copy to .env for local use. Never commit real values. In Netlify, set these in
# Site configuration → Environment variables (mark secrets as "Contains secret values").

# Managed PostgreSQL connection string (server-side only)
DATABASE_URL=
# Optional: DB_POOL_MAX=3, DATABASE_SSL=false (local only)

# Random string, at least 32 characters (signs the session cookie)
SESSION_SECRET=

# Google OAuth web client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Approved Google login(s), comma separated. Set privately in Netlify only — never in code or docs.
APPROVED_GOOGLE_EMAILS=

# Public base URL of this deploy context, e.g. the production site URL (used for the OAuth redirect)
APP_BASE_URL=

# Collector → app ingestion credential (bearer token, ≥ 32 random chars). Leave unset to disable the endpoint.
CORPORATE_INGEST_SECRET=
# Read-only reporting API for the Marketing Dashboard (>= 32 random chars, different from every other secret). Unset = disabled.
CORPORATE_REPORTING_SECRET=

# Optional: only if Product Master is made private. Service-account JSON key (sheet shared with it as Viewer).
# Without it, the public CSV export of each tab is used.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional override; defaults to https://succulentsbox.com
# SHOPIFY_CATALOG_ORIGIN=

# Corporate sample box signups (private Google Form response sheet), read through the team's Apps Script
# spreadsheet reader (the Marketing Dashboard's reader; add the sheet id to its ALLOWED_FILE_IDS).
# Only columns A (Timestamp) and B (First name) of the tab are used. The report returns a count only.
SAMPLE_SIGNUP_SHEET_ID=
# SAMPLE_SIGNUP_TAB=Sheet1
SHEET_READER_URL=
SHEET_READER_KEY=

# Slack scanner → Supplier Resources workflow (docs/SLACK_WORKFLOW.md). Different from every other secret.
CORPORATE_SLACK_INGEST_SECRET=
